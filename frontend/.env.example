# SignBridge frontend configuration
# Leave empty to use the Vite dev proxy (/api and /ws -> 127.0.0.1:8000).
VITE_API_URL=
VITE_WS_URL=

# ---- WebRTC ICE servers ----
# Public STUN is used by default. Add a TURN relay for students behind strict
# NAT/firewalls. WARNING: VITE_* values are public in the built JavaScript, so
# a static TURN password is only suitable for testing. In production, issue
# short-lived credentials from your backend (coturn use-auth-secret).
VITE_STUN_URLS=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- MediaPipe hand-tracking demo (optional self-hosting) ----
# Defaults load the model from Google storage and WASM from jsDelivr.
VITE_HAND_MODEL_URL=
VITE_MEDIAPIPE_WASM_URL=
VITE_SHOW_DEMO_LOGIN=false
