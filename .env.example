# ============================================================
# SignBridge — root environment example
# Copy to backend/.env (or export these variables) and edit.
# Never commit real secrets.
# ============================================================

# ---------- Application ----------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-me-with-a-long-random-string-min-32-chars
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ---------- Database ----------
# Production (MySQL):
# DATABASE_URL=mysql+pymysql://signbridge:password@127.0.0.1:3306/signbridge?charset=utf8mb4
# Development default (zero-setup SQLite):
DATABASE_URL=sqlite:///./signbridge.db
AUTO_CREATE_TABLES=true
# MUST be false when ENVIRONMENT=production (the backend refuses to start otherwise).
SEED_DEMO_DATA=true

# ---------- Storage ----------
STORAGE_ROOT=./storage
MAX_RECORDING_MB=512
MAX_MATERIAL_MB=64

# ---------- Live subtitles / translation ----------
# auto = try deepl -> google -> libretranslate -> mymemory
# Options: auto | mymemory | libretranslate | deepl | google | none
TRANSLATION_PROVIDER=auto
TRANSLATION_TIMEOUT_SECONDS=10
MYMEMORY_EMAIL=
# Self-hosted LibreTranslate (recommended for privacy):
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# DeepL (supports a subset of the offered languages; the chain falls back automatically):
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com
# Google Cloud Translation v2:
GOOGLE_TRANSLATE_API_KEY=

# ---------- Speech-to-text ----------
# Live captions use the browser Web Speech API by default (no key required).
# Server-side transcription (uploaded audio) supports Whisper:
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional local inference (pip install faster-whisper):
ENABLE_LOCAL_WHISPER=false
WHISPER_MODEL=base

# ---------- Media / WebRTC ----------
# Comma-separated ICE servers used by the frontend (configure in frontend/.env).
# Example TURN entry: turn:turn.example.com:3478|username|credential
